# LF everywhere: Git stores and checks out text as LF so line endings are consistent on all OSes.
* text=auto eol=lf

# Shell hook (explicit; same as default above)
.githooks/pre-commit text eol=lf

# Solution file (explicit; generated as LF by UpdateSlnx.cs)
RoboSharp.slnx text eol=lf

# Do not treat these as text (avoid CRLF normalization corrupting binaries)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary
*.snupkg binary
*.zip binary
*.pdf binary
