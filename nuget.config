<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Single public feed for this repo (AGENTS.md: BCL, Microsoft.Extensions.*, TUnit only).
    <clear /> drops inherited machine/user feeds so central package management does not require
    multi-source packageSourceMapping (NU1507).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
